                  "properties": {
                    "cardId": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cardId",
                    "label"
                  ]
                },
                "startPosition": {
                  "type": "object",
                  "properties": {
                    "cardId": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cardId",
                    "label"
                  ]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "cardId": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cardId",
                    "label"
                  ]
                },
                "courseOfFire": {
                  "type": "object",
                  "properties": {
                    "cardId": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cardId",
                    "label"
                  ]
                },
                "parSeconds": {
                  "type": "number"
                }
              },
              "required": [
                "time",
                "distance",
                "startPosition",
                "target",
                "courseOfFire"
              ]
            }
          },
          "required": [
            "trainee",
            "rawSeconds"
          ]
        },
        "outputSchema": null
